# The site's real production URL (no trailing slash), e.g. https://greenvitaltravel.com
# Drives metadataBase, canonical URLs, the sitemap, robots.txt, and JSON-LD structured data.
# Without this set, the site falls back to localhost during local development.
NEXT_PUBLIC_SITE_URL=

# Optional production email/CRM integrations for real lead capture.
# If you set RESEND_API_KEY, contact and booking inquiries are emailed to BUSINESS_EMAIL.
RESEND_API_KEY=
BUSINESS_EMAIL=greenvitaltravelandtouragencyl@gmail.com
EMAIL_FROM=

# Optional: a Resend Audience ID (from the Resend dashboard) to actually add
# newsletter signups to a mailing list, rather than just emailing BUSINESS_EMAIL
# a one-off notification of each signup. Requires RESEND_API_KEY above.
RESEND_AUDIENCE_ID=

# Optional Supabase storage for structured lead records.
# This is useful if you want the website to save inquiries in a table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: powers the website chatbot with a real AI model, tried in order —
# Groq first, then Gemini — so a rate limit or outage on one doesn't drop
# straight to the rule-based bot. Neither needs a credit card. Without either
# set, the chatbot still works via the built-in rule-based assistant.
#
# Groq (free): get a key at https://console.groq.com/keys.
GROQ_API_KEY=
# Optional override — defaults to openai/gpt-oss-20b if unset. Not every
# model is enabled for every account — check console.groq.com/playground
# to see which chat models actually work for this key before changing this.
GROQ_MODEL=
#
# Gemini (free): get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional override — defaults to gemini-3.6-flash if unset. See
# https://ai.google.dev/gemini-api/docs/models for current free-tier models.
GEMINI_MODEL=

# Powers the /admin visual editor (TinaCMS) so non-technical staff can edit
# site content without touching code. Free at https://app.tina.io — create a
# project connected to this GitHub repo, then copy the Client ID and a
# read-only token it gives you. Without these set, the site still builds and
# runs fine — the admin panel is just unavailable until they're added.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
