# The site's real production URL (no trailing slash), e.g. https://greenvitaltravel.com
# Drives metadataBase, canonical URLs, the sitemap, robots.txt, and JSON-LD structured data.
# Without this set, the site falls back to localhost during local development.
NEXT_PUBLIC_SITE_URL=

# Optional production email/CRM integrations for real lead capture.
# If you set RESEND_API_KEY, contact and booking inquiries are emailed to BUSINESS_EMAIL.
RESEND_API_KEY=
BUSINESS_EMAIL=greenvitalenvironmental@gmail.com
EMAIL_FROM=

# Optional Supabase storage for structured lead records.
# This is useful if you want the website to save inquiries in a table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
